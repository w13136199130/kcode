{
  "name": "@kcode/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @kcode/host build && tsup && vite build",
    "dev": "node scripts/dev.mjs",
    "smoke": "pnpm run build && electron dist/main.cjs --kcode-smoke",
    "test:e2e": "pnpm run build && playwright test",
    "dist": "pnpm run build && node scripts/stage-rg.mjs && electron-builder --win",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@kcode/contracts": "workspace:*",
    "@kcode/design": "workspace:*",
    "@tanstack/react-virtual": "^3.14.13",
    "@vscode/ripgrep": "^1.18.0",
    "lucide-react": "^1.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
