{
  "name": "@kcode/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kcode/host build && tsup",
    "dev": "node scripts/dev.mjs",
    "smoke": "pnpm run build && electron dist/main.cjs --kcode-smoke",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@kcode/contracts": "workspace:*",
    "@kcode/design": "workspace:*",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
