{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/fixtures/**"
  ],
  "rules": {
    "no-console": "error",
    "max-lines": ["error", 500]
  },
  "overrides": [
    {
      "files": [
        "packages/shared/src/logger.ts",
        "evals/src/acceptance-cli.ts",
        "services/server/src/**",
        "services/server/test/**",
        "apps/cli/scripts/**",
        "apps/cli/bin/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
